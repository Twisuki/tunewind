{
  "name": "tunewind",
  "type": "module",
  "version": "0.0.0",
  "packageManager": "pnpm@11.24.0",
  "description": "A highly configurable, strongly constrained, and extensible atomic CSS solution and design system",
  "author": "Twisuki",
  "homepage": "https://github.com/Twisuki/tunewind#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Twisuki/tunewind.git"
  },
  "bugs": {
    "url": "https://github.com/Twisuki/tunewind/issues"
  },
  "keywords": [
    "atomic-css",
    "css-variables",
    "design-system",
    "design-tokens",
    "tailwind",
    "tailwindcss"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "files": [
    "README.md",
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "fix": "eslint . --fix",
    "commitlint": "commitlint --edit",
    "prepare": "husky",
    "build": "tsdown",
    "prepack": "pnpm build"
  },
  "peerDependencies": {
    "postcss": "^8.4.0"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@changesets/cli": "^3.0.3",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-format": "^2.0.1",
    "husky": "^9.1.7",
    "postcss": "^8.5.32",
    "tsdown": "^0.23.5",
    "typescript": "^6.0.3"
  }
}
